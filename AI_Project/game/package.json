{
  "name": "shinobi-arena",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tools/replay_hash.mjs check && node tools/test_samurai.mjs && node tools/test_clone.mjs && node tools/test_agents.mjs && node tools/test_audio.mjs",
    "arena": "node tools/arena.mjs",
    "benchmark": "node tools/arena.mjs --roundrobin minimax,mcts,fuzzy,scripted,random --matches 200 --seed 2026 --budget minimax=nodes:600,mcts=rollouts:250 --react 9 --tag rr_main",
    "ga": "node tools/ga_tune.mjs --pop 16 --gens 15 --matches 4 --seed 7",
    "charts": "node tools/charts.mjs",
    "serve": "cd .. && python -m http.server 8767",
    "audio:render": "node tools/render_audio.mjs"
  },
  "dependencies": { "pixi.js": "^8.6.6" }
}
